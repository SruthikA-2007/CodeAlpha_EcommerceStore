# ==========================================================================
# CodeAlpha E-Commerce Store - Environment Configurations Template
# ==========================================================================

# Port the local Express web server runs on
PORT=3000

# Local or Production MongoDB Atlas connection URI
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce

# Secure session secret key utilized for express-session cookie encryption
SESSION_SECRET=your_super_secret_session_key_here
