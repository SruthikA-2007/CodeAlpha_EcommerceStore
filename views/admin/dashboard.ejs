<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store Admin</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">View Store</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white"><i class="fas fa-user-shield me-1 text-indigo"></i> <%= user.name %> (Admin)</span>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5 mb-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h2 class="fw-bold m-0"><i class="fas fa-tasks me-2"></i>Product Catalog Management</h2>
            <a href="/admin/products/new" class="btn btn-primary px-4 py-2.5"><i class="fas fa-plus me-2"></i>Add New Product</a>
        </div>

        <% if (!products || products.length === 0) { %>
            <div class="text-center py-5 shadow-sm rounded bg-white">
                <i class="fas fa-box-open fa-4x text-muted mb-3"></i>
                <p class="lead">No products found in the catalog.</p>
                <a href="/admin/products/new" class="btn btn-primary px-4 mt-2">Add First Product</a>
            </div>
        <% } else { %>
            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="py-3 px-4" style="width: 100px;">Image</th>
                            <th scope="col" class="py-3">Product Name</th>
                            <th scope="col" class="py-3">Category</th>
                            <th scope="col" class="py-3">Price</th>
                            <th scope="col" class="py-3 text-center" style="width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach(product => { %>
                            <tr>
                                <td class="py-3 px-4">
                                    <img src="<%= product.imageUrl %>" alt="<%= product.name %>" class="rounded border" style="width: 55px; height: 55px; object-fit: cover;">
                                </td>
                                <td class="py-3">
                                    <h6 class="mb-0 fw-bold text-dark text-truncate" style="max-width: 250px;" title="<%= product.name %>">
                                        <%= product.name %>
                                    </h6>
                                    <span class="text-warning small">
                                        <%= '★'.repeat(Math.round(product.rating || 0)) %><%= '☆'.repeat(5 - Math.round(product.rating || 0)) %>
                                    </span>
                                </td>
                                <td class="py-3">
                                    <span class="badge bg-secondary-subtle text-secondary px-2.5 py-1.5"><%= product.category %></span>
                                </td>
                                <td class="py-3 fw-bold text-success">
                                    $<%= product.price.toFixed(2) %>
                                </td>
                                <td class="py-3 text-center">
                                    <div class="d-flex justify-content-center gap-2">
                                        <a href="/admin/products/<%= product._id %>/edit" class="btn btn-outline-primary btn-sm px-3" title="Edit Product">
                                            <i class="fas fa-edit me-1"></i>Edit
                                        </a>
                                        <form action="/admin/products/<%= product._id %>/delete" method="POST" class="m-0 delete-product-form" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                            <button type="submit" class="btn btn-danger btn-sm px-3" title="Delete Product">
                                                <i class="fas fa-trash-alt me-1"></i>Delete
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
