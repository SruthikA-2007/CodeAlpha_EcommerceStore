<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= product.name %> - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome for stars -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .details-img {
            max-height: 500px;
            object-fit: contain;
            width: 100%;
        }
        .related-img {
            height: 180px;
            object-fit: cover;
        }
        .star-rating {
            color: #ffc107;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active" href="/products">Products</a>
                    </li>
                    <!-- Dynamic Cart indicator -->
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1 text-white" href="/cart">
                            <i class="fas fa-shopping-cart me-1 text-white"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Product Details Content -->
    <div class="container mt-5 mb-5">
        <div class="row">
            <!-- Product Image -->
            <div class="col-md-6 text-center">
                <img src="<%= product.imageUrl %>" class="img-fluid rounded shadow-sm details-img" alt="<%= product.name %>">
            </div>
            
            <!-- Product Info -->
            <div class="col-md-6 mt-4 mt-md-0">
                <h2 class="fw-bold"><%= product.name %></h2>
                <div class="mb-3">
                    <span class="badge bg-secondary"><%= product.category %></span>
                </div>
                
                <!-- Star Rating UI -->
                <div class="mb-3 d-flex align-items-center">
                    <div class="star-rating me-2">
                        <% for (let i = 1; i <= 5; i++) { %>
                            <% if (i <= Math.floor(product.rating)) { %>
                                <i class="fas fa-star"></i>
                            <% } else if (i - 0.5 <= product.rating) { %>
                                <i class="fas fa-star-half-alt"></i>
                            <% } else { %>
                                <i class="far fa-star"></i>
                            <% } %>
                        <% } %>
                    </div>
                    <span class="text-muted">(<%= product.rating %>/5 from <%= product.numReviews %> reviews)</span>
                </div>
                
                <h3 class="text-success fw-bold mb-4">$<%= product.price.toFixed(2) %></h3>
                
                <h5 class="fw-semibold">Description</h5>
                <p class="text-muted leading-relaxed mb-4">
                    <%= product.description %>
                </p>
                
                <hr>

                <!-- Add to Cart Form -->
                <form action="/cart" method="POST" class="mt-4 add-to-cart-form">
                    <input type="hidden" name="productId" value="<%= product._id %>">
                    <div class="row g-3 align-items-center">
                        <div class="col-auto">
                            <label for="quantity" class="col-form-label fw-semibold">Quantity:</label>
                        </div>
                        <div class="col-auto" style="width: 100px;">
                            <input type="number" id="quantity" name="quantity" class="form-control" value="1" min="1" required>
                        </div>
                        <div class="col-auto">
                            <button type="submit" class="btn btn-primary px-4"><i class="fas fa-shopping-cart me-2"></i>Add to Cart</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>

        <!-- Related Products Section -->
        <% if (relatedProducts && relatedProducts.length > 0) { %>
            <div class="mt-5 pt-5 border-top">
                <h3 class="fw-bold mb-4">Related Products</h3>
                <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4">
                    <% relatedProducts.forEach(rel => { %>
                        <div class="col">
                            <div class="card h-100 shadow-sm border-0">
                                <a href="/products/<%= rel._id %>">
                                    <img src="<%= rel.imageUrl %>" class="card-img-top related-img" alt="<%= rel.name %>">
                                </a>
                                <div class="card-body d-flex flex-column">
                                    <h6 class="card-title text-truncate mb-1">
                                        <a href="/products/<%= rel._id %>" class="text-decoration-none text-dark fw-bold"><%= rel.name %></a>
                                    </h6>
                                    <div class="star-rating small mb-2">
                                        <% for (let i = 1; i <= 5; i++) { %>
                                            <% if (i <= Math.floor(rel.rating)) { %>
                                                <i class="fas fa-star"></i>
                                            <% } else if (i - 0.5 <= rel.rating) { %>
                                                <i class="fas fa-star-half-alt"></i>
                                            <% } else { %>
                                                <i class="far fa-star"></i>
                                            <% } %>
                                        <% } %>
                                    </div>
                                    <span class="text-success fw-bold mb-3">$<%= rel.price.toFixed(2) %></span>
                                    <a href="/products/<%= rel._id %>" class="btn btn-outline-primary btn-sm mt-auto">View Details</a>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
