<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Confirmed - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .tracker-step {
            flex: 1;
            text-align: center;
            position: relative;
        }
        .tracker-step:not(:last-child)::after {
            content: '';
            position: absolute;
            top: 15px;
            left: 50%;
            width: 100%;
            height: 4px;
            background-color: #dee2e6;
            z-index: 1;
        }
        .tracker-step.active:not(:last-child)::after {
            background-color: #198754;
        }
        .tracker-icon {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            background-color: #dee2e6;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            position: relative;
            z-index: 2;
        }
        .tracker-step.active .tracker-icon {
            background-color: #198754;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1 text-white" href="/cart">
                            <i class="fas fa-shopping-cart me-1 text-white"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5 mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Success Header -->
                <div class="text-center mb-5">
                    <i class="fas fa-check-circle fa-5x text-success mb-3"></i>
                    <h2 class="fw-bold">Thank You for Your Order!</h2>
                    <p class="lead text-muted">Your order has been placed successfully and is currently being processed.</p>
                </div>

                <!-- Order Status Tracker -->
                <div class="card border-0 shadow-sm rounded mb-4">
                    <div class="card-body p-4 bg-white rounded shadow-sm">
                        <h5 class="fw-bold mb-4 text-center">Order Tracking Status</h5>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3 mb-3">
                            <div class="tracker-step active">
                                <div class="tracker-icon"><i class="fas fa-box-open"></i></div>
                                <div class="small fw-semibold mt-2">Pending</div>
                            </div>
                            <div class="tracker-step <%= (order.status === 'Shipped' || order.status === 'Delivered') ? 'active' : '' %>">
                                <div class="tracker-icon"><i class="fas fa-shipping-fast"></i></div>
                                <div class="small fw-semibold mt-2">Shipped</div>
                            </div>
                            <div class="tracker-step <%= (order.status === 'Delivered') ? 'active' : '' %>">
                                <div class="tracker-icon"><i class="fas fa-home"></i></div>
                                <div class="small fw-semibold mt-2">Delivered</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Order Info -->
                <div class="card border-0 shadow-sm rounded mb-4 bg-white">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Order Details</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-sm-6">
                                <span class="text-muted small">Order ID</span>
                                <p class="fw-bold text-dark mb-0"><%= order._id %></p>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small">Date Placed</span>
                                <p class="fw-semibold text-dark mb-0"><%= order.createdAt.toLocaleDateString() %></p>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small">Shipping Address</span>
                                <p class="text-dark mb-0"><%= order.shippingAddress %></p>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted small">Contact Phone</span>
                                <p class="text-dark mb-0"><%= order.phone %></p>
                            </div>
                        </div>

                        <hr>

                        <h5 class="fw-bold mb-3 mt-4">Ordered Products</h5>
                        <% order.products.forEach(item => { %>
                            <div class="d-flex align-items-center mb-3">
                                <% if (item.product) { %>
                                    <img src="<%= item.product.imageUrl %>" alt="<%= item.product.name %>" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold small text-truncate" style="max-width: 250px;"><%= item.product.name %></h6>
                                        <span class="text-muted small">Qty: <%= item.quantity %></span>
                                    </div>
                                    <span class="fw-bold text-success">$<%= (item.product.price * item.quantity).toFixed(2) %></span>
                                <% } else { %>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold small text-danger">Product No Longer Available</h6>
                                        <span class="text-muted small">Qty: <%= item.quantity %></span>
                                    </div>
                                <% } %>
                            </div>
                        <% }) %>

                        <hr>
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <h5 class="fw-bold m-0">Total Amount Paid</h5>
                            <h4 class="fw-bold text-success m-0">$<%= order.totalAmount.toFixed(2) %></h4>
                        </div>
                    </div>
                </div>

                <!-- Navigation Buttons -->
                <div class="text-center">
                    <a href="/orders/history" class="btn btn-primary px-4 py-2 fw-semibold me-2"><i class="fas fa-list me-2"></i>Order History</a>
                    <a href="/products" class="btn btn-outline-secondary px-4 py-2 fw-semibold">Continue Shopping</a>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
