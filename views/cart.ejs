<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Shopping Cart - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .cart-img {
            width: 80px;
            height: 80px;
            object-fit: cover;
        }
    </style>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <!-- Dynamic Cart indicator -->
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1" href="/cart">
                            <i class="fas fa-shopping-cart me-1"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5 mb-5">
        <h2 class="fw-bold mb-4"><i class="fas fa-shopping-cart me-2"></i>Your Shopping Cart</h2>

        <% if (!cart || cart.items.length === 0) { %>
            <div class="text-center py-5 shadow-sm rounded bg-white">
                <i class="fas fa-shopping-basket fa-4x text-muted mb-3"></i>
                <p class="lead">Your cart is currently empty.</p>
                <a href="/products" class="btn btn-primary px-4 mt-2">Go Shopping</a>
            </div>
        <% } else { %>
            <div class="row g-4">
                <!-- Cart Items Table -->
                <div class="col-lg-8">
                    <div class="table-responsive bg-white rounded shadow-sm">
                        <table class="table table-align-middle m-0">
                            <thead class="table-dark">
                                <tr>
                                    <th scope="col" class="py-3 px-4">Product</th>
                                    <th scope="col" class="py-3">Price</th>
                                    <th scope="col" class="py-3" style="width: 150px;">Quantity</th>
                                    <th scope="col" class="py-3">Total</th>
                                    <th scope="col" class="py-3 text-center" style="width: 100px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% cart.items.forEach(item => { %>
                                    <tr class="cart-item-row" data-product-id="<%= item.productId %>">
                                        <!-- Product Info -->
                                        <td class="py-3 px-4 align-middle">
                                            <div class="d-flex align-items-center">
                                                <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="rounded cart-img me-3">
                                                <div>
                                                    <h6 class="mb-0 fw-bold"><%= item.name %></h6>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- Price -->
                                        <td class="py-3 align-middle fw-semibold text-muted">
                                            $<%= item.price.toFixed(2) %>
                                        </td>
                                        <!-- Quantity Form -->
                                        <td class="py-3 align-middle">
                                            <form action="/cart/update" method="POST" class="d-flex align-items-center m-0 update-qty-form">
                                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                                <input type="number" name="quantity" class="form-control form-control-sm me-2 qty-input" value="<%= item.quantity %>" min="1" style="width: 65px;">
                                                <button type="submit" class="btn btn-outline-secondary btn-sm" title="Update Quantity">
                                                    <i class="fas fa-sync-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                        <td class="py-3 align-middle fw-bold text-success item-subtotal">
                                            $<%= (item.price * item.quantity).toFixed(2) %>
                                        </td>
                                        <!-- Remove Item Form -->
                                        <td class="py-3 align-middle text-center">
                                            <form action="/cart/remove" method="POST" class="m-0 remove-item-form">
                                                <input type="hidden" name="productId" value="<%= item.productId %>">
                                                <button type="submit" class="btn btn-danger btn-sm" title="Remove Product">
                                                    <i class="fas fa-trash-alt"></i>
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Order Summary Card -->
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm rounded">
                        <div class="card-body p-4">
                            <h5 class="card-title fw-bold mb-4">Order Summary</h5>
                            <div class="d-flex justify-content-between mb-3">
                                <span class="text-muted">Total Quantity</span>
                                <span class="fw-semibold" id="summary-total-qty"><%= cart.totalQuantity %> items</span>
                            </div>
                            <div class="d-flex justify-content-between mb-4">
                                <span class="text-muted">Shipping</span>
                                <span class="text-success fw-semibold">Free</span>
                            </div>
                            <hr>
                            <div class="d-flex justify-content-between mb-4">
                                <h5 class="fw-bold m-0">Total Price</h5>
                                <h5 class="fw-bold text-success m-0" id="summary-total-price">$<%= cart.totalPrice.toFixed(2) %></h5>
                            </div>
                            <a href="/orders/checkout" class="btn btn-primary w-100 py-2.5 fw-semibold mb-3">Proceed to Checkout</a>
                            <a href="/products" class="btn btn-outline-secondary w-100 py-2.5 fw-semibold">Continue Shopping</a>
                        </div>
                    </div>
                </div>
            </div>
        <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
