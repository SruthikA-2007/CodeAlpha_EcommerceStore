<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Checkout - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1 text-white" href="/cart">
                            <i class="fas fa-shopping-cart me-1 text-white"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5 mb-5">
        <h2 class="fw-bold mb-4"><i class="fas fa-credit-card me-2"></i>Checkout</h2>

        <div class="row g-4">
            <!-- Billing / Shipping Form -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded bg-white">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Shipping Information</h5>
                        <form action="/orders/checkout" method="POST">
                            <div class="mb-3">
                                <label for="name" class="form-label">Full Name</label>
                                <input type="text" class="form-control" id="name" value="<%= user.name %>" readonly disabled>
                            </div>
                            <div class="mb-3">
                                <label for="email" class="form-label">Email address</label>
                                <input type="email" class="form-control" id="email" value="<%= user.email %>" readonly disabled>
                            </div>
                            <div class="mb-3">
                                <label for="phone" class="form-label">Phone Number</label>
                                <input type="tel" name="phone" class="form-control" id="phone" placeholder="e.g. +123456789" required>
                            </div>
                            <div class="mb-4">
                                <label for="address" class="form-label">Shipping Address</label>
                                <textarea name="address" class="form-control" id="address" rows="4" placeholder="Enter your full street address, city, state, zip" required></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary w-100 py-2.5 fw-semibold"><i class="fas fa-lock me-2"></i>Place Order ($<%= cart.totalPrice.toFixed(2) %>)</button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Cart Items Summary -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded bg-light">
                    <div class="card-body p-4">
                        <h5 class="fw-bold mb-4">Order Summary</h5>
                        
                        <div class="mb-4" style="max-height: 300px; overflow-y: auto;">
                            <% cart.items.forEach(item => { %>
                                <div class="d-flex align-items-center mb-3">
                                    <img src="<%= item.imageUrl %>" alt="<%= item.name %>" class="rounded me-3" style="width: 50px; height: 50px; object-fit: cover;">
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold small text-truncate" style="max-width: 180px;"><%= item.name %></h6>
                                        <span class="text-muted small">Qty: <%= item.quantity %></span>
                                    </div>
                                    <span class="fw-bold text-success">$<%= (item.price * item.quantity).toFixed(2) %></span>
                                </div>
                            <% }) %>
                        </div>

                        <hr>
                        <div class="d-flex justify-content-between mb-2">
                            <span class="text-muted small">Items Total</span>
                            <span class="fw-semibold small"><%= cart.totalQuantity %> item(s)</span>
                        </div>
                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted small">Shipping</span>
                            <span class="text-success fw-semibold small">Free</span>
                        </div>
                        <hr>
                        <div class="d-flex justify-content-between">
                            <h5 class="fw-bold">Grand Total</h5>
                            <h5 class="fw-bold text-success">$<%= cart.totalPrice.toFixed(2) %></h5>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
