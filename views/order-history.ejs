<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Order History - E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1 text-white" href="/cart">
                            <i class="fas fa-shopping-cart me-1 text-white"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5 mb-5">
        <h2 class="fw-bold mb-4"><i class="fas fa-history me-2"></i>Your Order History</h2>

        <% if (!orders || orders.length === 0) { %>
            <div class="text-center py-5 shadow-sm rounded bg-white">
                <i class="fas fa-receipt fa-4x text-muted mb-3"></i>
                <p class="lead">You haven't placed any orders yet.</p>
                <a href="/products" class="btn btn-primary px-4 mt-2">Browse Products</a>
            </div>
        <% } else { %>
            <div class="table-responsive bg-white rounded shadow-sm">
                <table class="table table-hover align-middle m-0">
                    <thead class="table-dark">
                        <tr>
                            <th scope="col" class="py-3 px-4">Order ID</th>
                            <th scope="col" class="py-3">Date Placed</th>
                            <th scope="col" class="py-3">Items Purchased</th>
                            <th scope="col" class="py-3">Total Paid</th>
                            <th scope="col" class="py-3">Status</th>
                            <th scope="col" class="py-3 text-center" style="width: 150px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% orders.forEach(order => { %>
                            <tr>
                                <td class="py-3 px-4 fw-bold text-truncate" style="max-width: 150px;">
                                    <%= order._id %>
                                </td>
                                <td class="py-3 text-muted">
                                    <%= order.createdAt.toLocaleDateString() %>
                                </td>
                                <td class="py-3">
                                    <ul class="list-unstyled mb-0 small">
                                        <% order.products.forEach(item => { %>
                                            <% if (item.product) { %>
                                                <li><i class="fas fa-angle-right me-1 text-muted"></i><%= item.product.name %> (x<%= item.quantity %>)</li>
                                            <% } else { %>
                                                <li class="text-danger"><i class="fas fa-angle-right me-1"></i>Product Unavailable (x<%= item.quantity %>)</li>
                                            <% } %>
                                        <% }) %>
                                    </ul>
                                </td>
                                <td class="py-3 fw-bold text-success">
                                    $<%= order.totalAmount.toFixed(2) %>
                                </td>
                                <td class="py-3">
                                    <% if (order.status === 'Pending') { %>
                                        <span class="badge bg-warning text-dark px-2.5 py-1.5"><i class="fas fa-clock me-1"></i><%= order.status %></span>
                                    <% } else if (order.status === 'Shipped') { %>
                                        <span class="badge bg-info text-dark px-2.5 py-1.5"><i class="fas fa-shipping-fast me-1"></i><%= order.status %></span>
                                    <% } else if (order.status === 'Delivered') { %>
                                        <span class="badge bg-success px-2.5 py-1.5"><i class="fas fa-check-circle me-1"></i><%= order.status %></span>
                                    <% } else { %>
                                        <span class="badge bg-danger px-2.5 py-1.5"><i class="fas fa-times-circle me-1"></i><%= order.status %></span>
                                    <% } %>
                                </td>
                                <td class="py-3 text-center">
                                    <a href="/orders/success/<%= order._id %>" class="btn btn-outline-primary btn-sm px-3"><i class="fas fa-eye me-1"></i>View Details</a>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
