<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>E-commerce Store</title>
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Custom CSS -->
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand" href="/">E-Store</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item">
                        <a class="nav-link active" href="/">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/products">Products</a>
                    </li>
                    <!-- Dynamic Cart indicator -->
                    <li class="nav-item me-2">
                        <a class="btn btn-outline-light btn-sm position-relative px-3 py-1 text-white" href="/cart">
                            <i class="fas fa-shopping-cart me-1 text-white"></i> Cart
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger">
                                <%= cart.totalQuantity %>
                            </span>
                        </a>
                    </li>
                    <% if (user) { %>
                        <li class="nav-item">
                            <span class="nav-link text-white">Welcome, <%= user.name %>!</span>
                        </li>
                        <% if (user.isAdmin) { %>
                            <li class="nav-item">
                                <a class="nav-link" href="/admin" style="color: #818cf8 !important; font-weight: 600;"><i class="fas fa-user-shield me-1"></i>Admin</a>
                            </li>
                        <% } %>
                        <li class="nav-item">
                            <a class="nav-link" href="/orders/history">Orders</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/logout">Logout</a>
                        </li>
                    <% } else { %>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="/auth/register">Register</a>
                        </li>
                    <% } %>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <div class="container mt-5">
        <div class="hero-banner text-center py-5 px-4 shadow-lg">
            <i class="fas fa-shopping-bag fa-4x text-indigo mb-4" style="color: #6366f1;"></i>
            <h1 class="hero-title display-4 fw-extrabold"><%= title %></h1>
            <p class="lead text-muted max-w-md mx-auto mb-4" style="max-width: 600px; margin: 0 auto 2rem;">
                Welcome to the ultimate shopping destination. Explore curated collections, trending products, and enjoy free shipping on all orders worldwide.
            </p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/products" class="btn btn-primary btn-lg px-5 py-3 fw-bold"><i class="fas fa-rocket me-2"></i>Shop Collections</a>
                <a href="/auth/register" class="btn btn-outline-primary btn-lg px-5 py-3 fw-bold"><i class="fas fa-user-plus me-2"></i>Join Now</a>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="/js/main.js"></script>
</body>
</html>
